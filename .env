# Committed. Production configuration -- this is what a prod bundle is built
# from. VITE_POSTHOG_KEY is PostHog's *project* key: a public client token,
# already visible in the shipped bundle, so it is not a secret.
#
# Dev mode off by default, so anything built without an explicit dev flag is
# a production bundle: no results shortcut, telemetry on.
VITE_DEV_MODE=false
VITE_POSTHOG_KEY=phc_BuwCtUycm2JkPQ7pbTodevwbi7W6hFBdJXmib337Mc2R
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Where the results word cloud reads its counts from: the Modal endpoint in
# modal_app/word_cloud.py. That app holds the PostHog personal API key -- the
# key must never be in this file, which ships inside the bundle.
#
# Fill this in with the URL `modal deploy` prints. Left blank, the cloud falls
# back to its built-in sample data.
VITE_WORD_CLOUD_URL=https://parul--studyhall-word-cloud-word-cloud.modal.run
