# Copy to .env.local for local development. .env is committed and already
# carries the production values, so you only need the dev-mode switch.

# true  -> dev build: Restart + results shortcuts visible, four-card deck,
#          PostHog disabled
# false -> prod build: shortcuts hidden, full deck, PostHog enabled
#
# Either way, ?dev=1 on the page's address turns Dev Mode on for that visit and
# ?dev=0 turns it off, so the deployed production bundle can be handed out as a
# dev link without a second build.
VITE_DEV_MODE=true

# PostHog belongs in .env (committed), never in .env.local.
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional. The Modal endpoint serving the word-cloud counts, as printed by
# `modal deploy modal_app/word_cloud.py`. Left blank, the cloud falls back to
# its built-in sample data.
VITE_WORD_CLOUD_URL=
